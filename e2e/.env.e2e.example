# Playwright E2E — canlı müşteri hesabı kullanmayın.
# Bu dosyayı e2e/.env.e2e olarak kopyalayın (gitignore).

E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:4100

# Büro sahibi test kullanıcısı (yalnızca test tenant)
E2E_USER=e2e.sahip
E2E_PASSWORD=E2eTestPass123!

# İsteğe bağlı: katip / avukat senaryoları
# E2E_KATIP_USER=
# E2E_KATIP_PASSWORD=
# E2E_AVUKAT_USER=
# E2E_AVUKAT_PASSWORD=

# Tenant oluşturmak için admin (yoksa mevcut E2E_USER ile giriş yapılır)
# E2E_ADMIN_USER=admin
# E2E_ADMIN_PASSWORD=
